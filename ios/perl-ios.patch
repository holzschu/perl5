+#ifdef PERL_IOS
+/* ios_system admits one command per library and unloads it after return. */
+static int ios_perl_stdio[3] = {-1, -1, -1};
+
+PerlIO *
+ios_perl_popen(const char *cmd, const char *mode)
+{
+    FILE *stream = ios_popen(cmd, mode);
+    PerlIO *f;
+    if (!stream)
+        return NULL;
+    f = PerlIO_importFILE(stream, mode);
+    if (!f) {
+        int saved_errno = errno;
+        fclose(stream);
+        errno = saved_errno;
+    }
+    return f;
+}
+
+int
+ios_perl_isatty(int fd)
+{
+    if (fd >= 0) {
+        if (fd == ios_perl_stdio[0])
+            return ios_isatty(fileno(thread_stdin));
+        if (fd == ios_perl_stdio[1])
+            return ios_isatty(fileno(thread_stdout));
+        if (fd == ios_perl_stdio[2])
+            return ios_isatty(fileno(thread_stderr));
+    }
+    return ios_isatty(fd);
+}
+#endif
+
