+        ios_perl_stdio[0] = dup(fileno(thread_stdin));
+        ios_perl_stdio[1] = dup(fileno(thread_stdout));
+        ios_perl_stdio[2] = dup(fileno(thread_stderr));
+        PerlIO_fdopen(ios_perl_stdio[0], "Ir" PERLIO_STDTEXT);
+        PerlIO_fdopen(ios_perl_stdio[1], "Iw" PERLIO_STDTEXT);
+        err = PerlIO_fdopen(ios_perl_stdio[2], "Iw" PERLIO_STDTEXT);
+        if (err)
+            PerlIOBase(err)->flags |= PERLIO_F_UNBUF;
+#else
         PerlIO_fdopen(0, "Ir" PERLIO_STDTEXT);
         PerlIO_fdopen(1, "Iw" PERLIO_STDTEXT);
         PerlIO_fdopen(2, "Iw" PERLIO_STDTEXT);
+#endif
     }
 }
 
